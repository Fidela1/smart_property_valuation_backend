generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum PropertyStatus {
  PENDING
  APPROVED
  SOLD
  REJECTED
}

model User {
  id         String     @id @default(uuid())
  name       String?
  email      String     @unique
  phone      String?
  password   String
  role       Role       @default(USER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  properties Property[]
}

model Property {
  id           String          @id @default(uuid())
  userId       String
  title        String
  description  String?
  price        Float
  size         Float           // in square meters
  bedrooms     Int
  bathrooms    Int?
  city         String
  latitude     Float
  longitude    Float
  photos       String[]        // image URLs
  status       PropertyStatus  @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  valuations   Valuation[]

  @@index([city])
  @@index([price])
}

model Valuation {
  id             String    @id @default(uuid())
  propertyId     String
  predictedPrice Float
  confidence     Float?
  method         String?
  createdAt      DateTime  @default(now())

  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}